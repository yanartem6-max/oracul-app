# ORACUL Backend Configuration
# Copy this file to .env and fill in your actual values

# Server Port
PORT=3000

# Groq AI API Key (get from https://console.groq.com)
# CRITICAL: Never commit your actual API key to git!
GROQ_API_KEY=your_actual_groq_api_key_here

# Groq Model (see available models at https://console.groq.com)
GROQ_MODEL=openai/gpt-oss-20b

# Solana Fee Account (wallet address to receive swap fees)
# Use a dedicated wallet address you control
FEE_ACCOUNT=your_solana_wallet_address_here

# CORS Whitelist - additional allowed origins (comma-separated)
# Default whitelist includes: https://web.telegram.org, https://t.me, http://localhost:3000
# Add production domains here
ALLOWED_ORIGINS_CUSTOM=https://yourdomain.com,https://www.yourdomain.com
