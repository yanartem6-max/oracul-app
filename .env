PORT=3000
# API ключи
GROQ_API_KEY=your_groq_api_key_here

# Комиссии
FEE_ACCOUNT=your_solana_wallet_address  # Для Solana (если нужно)
FEE_WALLET_TON=EQD...your_ton_wallet_address  # Ваш TON кошелёк для получения комиссии
FEE_PERCENT=0.5  # Процент комиссии (0.5 = 0.5%)

# CORS (опционально)
ALLOWED_ORIGINS_CUSTOM=
